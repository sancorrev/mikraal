{
  "name": "mikraal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "openapi-typescript ../contracts/openapi/bff-web.yaml -o generated/bff-web.ts",
    "predev": "pnpm generate",
    "predev:mock": "pnpm generate",
    "dev": "next dev -p 3000",
    "dev:mock": "BFF_URL=http://localhost:4010 MIKRAAL_MOCK_SESSION=1 next dev -p 3000",
    "mock": "prism mock -d -p 4010 ../contracts/openapi/bff-web.yaml",
    "prebuild": "pnpm generate",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "pretypecheck": "pnpm generate",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/smoke.mjs",
    "screenshots": "node e2e/screenshots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:flows": "node e2e/flows.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
